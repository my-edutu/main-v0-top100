# Merge these flags into your private local environment; never replace the app's full configuration.
# Use an isolated Supabase instance and synthetic accounts. Do not copy live provider credentials.
TALENT_DISCOVERY_ENABLED=true
TALENT_DISCOVERY_LAUNCHED=false
TALENT_UPGRADE_EMAIL_ENABLED=false

# Only configure on the actual reviewed production release, not in a local review:
# TALENT_PUBLIC_ORIGIN=https://top100afl.com
# BREVO_API_KEY=<server-only, never commit>
# BREVO_SENDER_EMAIL=<verified sender>
