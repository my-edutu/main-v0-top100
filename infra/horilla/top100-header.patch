+<script>
+    if (!window.top100DisclosureWired) {
+        window.top100DisclosureWired = true;
+        const menuSelector = '[data-work-menu]';
+        function setMenu(menu, open) {
+            menu.toggleAttribute('data-open', open);
+            menu.querySelector(':scope > button').setAttribute('aria-expanded', String(open));
+        }
+        document.querySelectorAll(menuSelector).forEach((menu) => {
+            const button = menu.querySelector(':scope > button');
+            if (menu.classList.contains('work-profile')) {
+                button.setAttribute('aria-label', '{% trans "Account menu"|escapejs %}');
+            }
+            setMenu(menu, false);
+        });
+        document.addEventListener('click', (event) => {
+            const trigger = event.target.closest('[data-work-menu] > button');
+            document.querySelectorAll(menuSelector).forEach((menu) => {
+                if (trigger?.parentElement === menu) {
+                    setMenu(menu, !menu.hasAttribute('data-open'));
+                } else if (!menu.contains(event.target)) {
+                    setMenu(menu, false);
+                }
+            });
+            document.querySelectorAll('.work-tools[open], .work-period[open]').forEach((menu) => {
+                if (!menu.contains(event.target)) menu.open = false;
+            });
+        });
+        document.addEventListener('keydown', (event) => {
+            if (event.key !== 'Escape') return;
+            const menu = event.target.closest?.('.work-tools[open], .work-period[open], [data-work-menu][data-open]');
+            if (!menu) return;
+            if (menu.matches(menuSelector)) {
+                setMenu(menu, false);
+                menu.querySelector(':scope > button').focus();
+            } else {
+                menu.open = false;
+                menu.querySelector('summary').focus();
+            }
+        });
+    }
+</script>
