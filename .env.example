# GIG Logistics. Production quoting uses the documented Price V3 endpoint.
# Keep every credential server-only (never prefix with NEXT_PUBLIC_).
GIG_ENABLED=true
GIG_API_BASE_URL=https://dev-thirdpartynode.theagilitysystems.com
GIG_API_USERNAME=<the test email supplied by GIG>
GIG_API_PASSWORD=<the test password supplied by GIG>
GIG_PATH_QUOTE=price/v3
GIG_SENDER_NAME=Top100 Africa Future Leaders
GIG_SENDER_PHONE=+2348169400427
GIG_SENDER_ADDRESS=2 Okota Road, Beside Zenith Bank, By Cele Bus Stop, Lagos
GIG_SENDER_CITY=Lagos
GIG_SENDER_STATION_ID=4
GIG_SENDER_LATITUDE=6.529800
GIG_SENDER_LONGITUDE=3.314500
GIG_RECEIVER_STATION_ID=
GIG_RECEIVER_STATION_MAP_JSON={}
GIG_VEHICLE_TYPE=1
GIG_CUSTOMER_TYPE=0
GIG_PICKUP_OPTION=0
GIG_DELIVERY_OPTION_ID=0
GIG_ITEM_NAME=Award plaque
GIG_ITEM_DESCRIPTION=Top100 Africa Future Leaders award
GIG_ITEM_WEIGHT_KG=1
GIG_ITEM_QUANTITY=1
GIG_ITEM_VALUE_NAIRA=0
GIG_SHIPMENT_TYPE=1
GIG_GEOCODE_ENABLED=true
GIG_EXPECTED_CURRENCY=NGN

# Read-only outbound international price preview (Nigeria -> overseas).
# Confirm these against the outer packed award before arranging delivery.
GIG_INTL_PACKAGE_WEIGHT_KG=1
GIG_INTL_PACKAGE_LENGTH_CM=42
GIG_INTL_PACKAGE_WIDTH_CM=29.7
# No thickness was supplied. Leave blank until measured; never guess it.
GIG_INTL_PACKAGE_HEIGHT_CM=
GIG_INTL_DECLARED_VALUE_NAIRA=10000

# Server-only Nigerian address geocoding (Geoapify). Required for home delivery.
# Create a key at https://myprojects.geoapify.com/. Never expose it to the browser.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_TIMEOUT_MS=6000
GEOAPIFY_RETRIES=1
GEOAPIFY_MIN_CONFIDENCE=0

# Optional server-only AFL bot admin bridge (never prefix these with NEXT_PUBLIC_).
# See docs/afl-bot-admin-setup.md. Keep unset until private access is configured.
AFL_BOT_ADMIN_URL=
AFL_BOT_ADMIN_TOKEN=

# Project100 support groups. Keep collections disabled until the additive
# migration and dedicated Bachs webhook have been verified (see docs/operations/project100-impact.md).
PROJECT100_CHECKOUT_ENABLED=false
BACHS_PROJECT100_WEBHOOK_SECRET=
